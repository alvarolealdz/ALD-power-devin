{# [[ header_text ]] #}
{% extends "layout.html" %}

{% block content %}
  <h1>{{ heading }}</h1>
  {% include "partials/form.html" %}
  <p class="toolbar">
    <a href="{{ list_url }}">Back to [[ spec.title|lower ]]</a>
    {% if delete_url %}
      <form class="inline" action="{{ delete_url }}" method="post">
        <button type="submit">Delete</button>
      </form>
    {% endif %}
  </p>
{% endblock %}
