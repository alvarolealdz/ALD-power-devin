{# [[ header_text ]] #}
{% extends "layout.html" %}

{% block content %}
  <div class="page-head">
    <div><p class="crumbs"><a href="{{ list_url }}">[[ spec.title ]]</a></p><h1>{{ heading }}</h1></div>
  </div>
  <section class="card">
    {% include "partials/form.html" %}
  </section>
  <p class="toolbar">
    <a class="btn btn-ghost" href="{{ list_url }}">Back to [[ spec.title|lower ]]</a>
    {% if delete_url %}
      <form class="inline" action="{{ delete_url }}" method="post" data-confirm="Delete [[ spec.singular_title ]] #{{ row_id }}? This is recorded in the audit trail and cannot be undone.">
        <button class="btn btn-danger btn-sm" type="submit">Delete</button>
      </form>
    {% endif %}
  </p>
{% endblock %}
