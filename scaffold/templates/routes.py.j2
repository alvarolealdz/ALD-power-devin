TITLE = "[[ spec.title ]]"
DESCRIPTION = "[[ spec.description|replace('\\', '\\\\')|replace('"', '\\"') ]]"
SINGULAR = "[[ spec.singular_title|replace('\\', '\\\\')|replace('"', '\\"') ]]"
MODEL = [[ spec.class_name ]]
_SEARCHABLE = (
[% for field in spec.fields if field.type == "text" and not field.sensitive %]
    "[[ field.name ]]",
[% endfor %]
)
_ADMIN_SEARCHABLE = (
[% for field in spec.fields if field.type == "text" and field.sensitive %]
    "[[ field.name ]]",
[% endfor %]
)
_SORTABLE = (
[% for field in spec.fields if field.type in ("text", "number", "date", "bool", "enum") and not field.sensitive %]
    "[[ field.name ]]",
[% endfor %]
    "id",
)
_ADMIN_SORTABLE = (
    *_SORTABLE,
[% for field in spec.fields if field.type in ("text", "number", "date", "bool", "enum") and field.sensitive %]
    "[[ field.name ]]",
[% endfor %]
)
[% if spec.workflow_field %]
WORKFLOW_FIELD = "[[ spec.workflow_field.name ]]"
OPEN_STATES = (
[% for option in spec.workflow_field.open %]
    "[[ option ]]",
[% endfor %]
)
[[ spec.workflow_field.name|upper ]]_CLOSED = (
[% for option in spec.workflow_field.closed %]
    "[[ option ]]",
[% endfor %]
)
[% endif %]

router = APIRouter(prefix="[[ spec.mount_path ]]", tags=["[[ spec.app ]]"])

_TOGGLEABLE = (
[% for field in spec.fields if field.type == "bool" %]
    "[[ field.name ]]",
[% endfor %]
)
_SENSITIVE_TOGGLEABLE = (
[% for field in spec.fields if field.type == "bool" and field.sensitive %]
    "[[ field.name ]]",
[% endfor %]
)


def _next_url(request: Request) -> str:
    return request.url.path + (f"?{request.url.query}" if request.url.query else "")


def _redirect_next(request: Request, next_url: str) -> RedirectResponse:
    mount_path = "[[ spec.mount_path ]]"
    target = (
        next_url
        if next_url == mount_path or next_url.startswith(f"{mount_path}?")
        else str(request.url_for("[[ spec.app ]]_list"))
    )
    return RedirectResponse(target, status_code=303)

[% if spec.workflow_field %]
def _decision_options(current: str) -> tuple[str, ...]:
    return [[ spec.workflow_field.name|upper ]]_TRANSITIONS.get(
        current,
        tuple(
            option
            for option in [[ spec.workflow_field.name|upper ]]_OPTIONS
            if option != current
        ),
    )

[% endif %]

def _get(session: Session, [[ spec.entity ]]_id: int) -> [[ spec.class_name ]]:
    row = session.get([[ spec.class_name ]], [[ spec.entity ]]_id)
    if row is None:
        raise HTTPException(status_code=404, detail="[[ spec.title ]]: no such row")
    return row


def _columns(
    request: Request,
    admin: bool,
    *,
    state: str | None,
    q: str,
    sort: str,
    direction: str,
) -> list[dict[str, object]]:
    """What the list view shows. Sensitive columns never reach a non-admin."""
    columns = []
[% for field in spec.fields %]
[% if field.name not in spec.unit_field_names %]
[% if field.sensitive %]
    if admin:
        columns.append({"key": "[[ field.name ]]", "label": "[[ field.label ]]", "kind": ("link" if not columns else "[[ column_kinds[field.name] ]]")})
[% else %]
    columns.append({"key": "[[ field.name ]]", "label": "[[ field.label ]]", "kind": ("link" if not columns else "[[ column_kinds[field.name] ]]")})
[% endif %]
[% endif %]
[% endfor %]
    columns.append({"key": "id", "label": "ID", "kind": "id"})
    sortable = _ADMIN_SORTABLE if admin else _SORTABLE
    for column in columns:
        key = column["key"]
        if key not in sortable:
            continue
        next_direction = (
            "desc" if sort == key and direction == "asc" else "asc"
        )
        params = {"sort": key, "dir": next_direction}
        if state is not None:
            params["state"] = state
        if q:
            params["q"] = q
        column["sort_href"] = f"{request.url.path}?{urlencode(params)}"
        if sort == key:
            column["sorted"] = direction
    return columns


def _row(
    request: Request,
    row: [[ spec.class_name ]],
    admin: bool,
    writable: bool,
    next_url: str,
) -> dict[str, object]:
    data: dict[str, object] = {
[% for field in spec.fields if not field.sensitive and field.name not in spec.unit_field_names %]
        "[[ field.name ]]": [[ field_value_expressions[field.name] ]],
[% endfor %]
    }
[% if spec.sensitive_fields %]
    if admin:
[% for field in spec.fields if field.sensitive and field.name not in spec.unit_field_names %]
        data["[[ field.name ]]"] = [[ field_value_expressions[field.name] ]]
[% endfor %]
[% endif %]
    ordered = {key: data[key] for key in [[ spec.fields|map(attribute="name")|list ]] if key in data}
    if ordered:
        first_key = next(iter(ordered))
        first_value = ordered[first_key]
        ordered[first_key] = {
            "label": first_value["label"] if isinstance(first_value, dict) else first_value,
            "href": str(request.url_for("[[ spec.app ]]_detail", [[ spec.entity ]]_id=row.id)),
        }
    ordered["id"] = row.id
    ordered["edit_url"] = str(request.url_for("[[ spec.app ]]_edit", [[ spec.entity ]]_id=row.id))
[% if spec.workflow_field %]
    ordered["decisions"] = [
        {
            "label": option,
            "value": option,
            "tone": [[ spec.workflow_field.name|upper ]]_TONES.get(option, "neutral"),
            "action": str(request.url_for("[[ spec.app ]]_decide", [[ spec.entity ]]_id=row.id)),
            "field": WORKFLOW_FIELD,
            "expected": row.[[ spec.workflow_field.name ]],
            "next": next_url,
        }
        for option in _decision_options(row.[[ spec.workflow_field.name ]])
    ] if writable else []
[% else %]
    ordered["decisions"] = []
[% endif %]
    return ordered


def _items(row: [[ spec.class_name ]], admin: bool) -> list[dict[str, object]]:
    items: list[dict[str, object]] = []
[% for field in spec.fields %]
[% if field.name not in spec.unit_field_names %]
[% if field.sensitive %]
    if admin:
        items.append(
            {"label": "[[ field.label ]]", "value": [[ detail_value_expressions[field.name] ]][% if field.type in ("enum", "bool") %], "kind": "badge"[% endif %]}
        )
[% else %]
    items.append(
        {"label": "[[ field.label ]]", "value": [[ detail_value_expressions[field.name] ]][% if field.type in ("enum", "bool") %], "kind": "badge"[% endif %]}
    )
[% endif %]
[% endif %]
[% endfor %]
    return items


def _fields(
    session: Session, values: dict[str, object], admin: bool
) -> list[dict[str, object]]:
    """Form fields for the generic partial. Sensitive fields are admin-only."""
    fields: list[dict[str, object]] = [
[% for field in visible_fields %]
        [[ field_form[field.name] ]],
[% endfor %]
    ]
[% if spec.sensitive_fields %]
    if admin:
        fields.extend(
            [
[% for field in spec.sensitive_fields %]
                [[ field_form[field.name] ]],
[% endfor %]
            ]
        )
[% endif %]
[% if spec.workflow_field %]
    workflow_value = values.get(WORKFLOW_FIELD)
    if workflow_value in [[ spec.workflow_field.name|upper ]]_OPTIONS:
        workflow_options = (
            workflow_value,
            *[[ spec.workflow_field.name|upper ]]_TRANSITIONS.get(
                workflow_value,
                tuple(
                    option
                    for option in [[ spec.workflow_field.name|upper ]]_OPTIONS
                    if option != workflow_value
                ),
            ),
        )
        for field in fields:
            if field["name"] == WORKFLOW_FIELD:
                field["options"] = [
                    {"value": option, "label": option} for option in workflow_options
                ]
[% endif %]
    return fields


[% if reference_rows %]
#: Foreign keys to check before writing: (column, table, model).
_REFERENCES = (
[% for line in reference_rows %]
    [[ line ]],
[% endfor %]
)


def _check_references(
    session: Session, values: dict[str, object], errors: dict[str, str]
) -> None:
    """A well-formed id pointing at nothing is a bad request, not an IntegrityError."""
    for column, table, model in _REFERENCES:
        value = values.get(column)
        if value is not None and session.get(model, value) is None:
            errors[column] = f"no such {table}"


[% endif %]
def _parse(raw: dict[str, str | None], admin: bool) -> tuple[dict[str, object], dict[str, str]]:
    values: dict[str, object] = {}
    errors: dict[str, str] = {}
[% for line in parse_visible %]
    [[ line ]]
[% endfor %]
[% if spec.sensitive_fields %]
    if admin:
[% for line in parse_sensitive %]
        [[ line ]]
[% endfor %]
[% endif %]
    return values, errors


def _form_page(
    request: Request,
    session: Session,
    values: dict[str, object],
    errors: dict[str, str],
    admin: bool,
    *,
    action: str,
    heading: str,
    writable: bool = True,
    delete_url: str | None = None,
    detail_url: str | None = None,
    row_id: int | None = None,
    status_code: int = 200,
):
    return templates.TemplateResponse(
        request,
        "[[ spec.app ]]/form.html",
        {
            "title": heading,
            "heading": heading,
            "action": action,
            "fields": _fields(session, values, admin),
            "errors": errors,
            "submit_label": "Save" if writable else None,
            "list_url": str(request.url_for("[[ spec.app ]]_list")),
            "delete_url": delete_url if writable else None,
            "detail_url": detail_url,
            "row_id": row_id,
        },
        status_code=status_code,
    )


@router.get("", name="[[ spec.app ]]_list")
def list_rows(
    request: Request,
    session: DbSession,
    current_user: CurrentUser,
[% if spec.workflow_field %]
    state: str = "",
[% endif %]
    q: str = "",
    sort: str = "",
    dir: str = "asc",
):
    admin = auth.is_admin(current_user)
    q = q.strip()
    searchable = _SEARCHABLE + (_ADMIN_SEARCHABLE if admin else ())
    sortable = _ADMIN_SORTABLE if admin else _SORTABLE
    normalized_sort = sort if sort in sortable else ""
    normalized_dir = dir if dir in {"asc", "desc"} else "asc"
    query = select(MODEL)
    if q and searchable:
        escaped = q.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
        pattern = f"%{escaped}%"
        query = query.where(
            or_(*(getattr(MODEL, column).ilike(pattern, escape="\\") for column in searchable))
        )
[% if spec.workflow_field %]
    workflow_column = getattr(MODEL, WORKFLOW_FIELD)
    grouped = dict(
        session.execute(select(workflow_column, func.count()).group_by(workflow_column)).all()
    )
    open_count = sum(grouped.get(option, 0) for option in OPEN_STATES)
    total = sum(grouped.values())
    if state == "":
        query = query.where(workflow_column.in_(OPEN_STATES))
    elif state == "all":
        pass
    elif state in [[ spec.workflow_field.name|upper ]]_OPTIONS:
        query = query.where(workflow_column == state)
    else:
        raise HTTPException(status_code=400, detail="invalid state")
    list_url = str(request.url_for("[[ spec.app ]]_list"))
    tabs = [
        {"label": "Needs decision", "href": list_url, "count": open_count, "active": state == ""}
    ]
    tabs.extend(
        {
            "label": option.title(),
            "href": f"{list_url}?{urlencode({'state': option})}",
            "count": grouped.get(option, 0),
            "active": state == option,
        }
        for option in [[ spec.workflow_field.name|upper ]]_OPTIONS
    )
    tabs.append(
        {
            "label": "All",
            "href": f"{list_url}?state=all",
            "count": total,
            "active": state == "all",
        }
    )
    today_start = datetime.now(UTC).replace(
        hour=0, minute=0, second=0, microsecond=0, tzinfo=None
    )
    decided_today = sum(
        1
        for entry in session.scalars(
            select(AuditLog).where(
                AuditLog.table_name == MODEL.__tablename__,
                AuditLog.action == AuditLog.ACTION_UPDATE,
                AuditLog.created_at >= today_start,
            )
        )
        if (entry.after or {}).get(WORKFLOW_FIELD) in [[ spec.workflow_field.name|upper ]]_CLOSED
        and (entry.before or {}).get(WORKFLOW_FIELD) not in [[ spec.workflow_field.name|upper ]]_CLOSED
        and (entry.after or {}).get(WORKFLOW_FIELD) != (entry.before or {}).get(WORKFLOW_FIELD)
    )
[% else %]
    state = None
[% endif %]
    if normalized_sort:
        sort_column = getattr(MODEL, normalized_sort)
        query = query.order_by(
            sort_column.asc() if normalized_dir == "asc" else sort_column.desc()
        )
[% if spec.workflow_field %]
    elif state == "":
        query = query.order_by(MODEL.id.asc())
    else:
        query = query.order_by(MODEL.id.desc())
[% else %]
    else:
        query = query.order_by(MODEL.id.desc())
[% endif %]
    rows = session.scalars(query).all()
    next_url = _next_url(request)
    new_url = (
        str(request.url_for("[[ spec.app ]]_new"))
[% if spec.create_is_admin_only %]
        if auth.is_admin(current_user)
[% else %]
        if auth.can_write(current_user)
[% endif %]
        else None
    )
    return templates.TemplateResponse(
        request,
        "[[ spec.app ]]/list.html",
        {
            "title": TITLE,
            "columns": _columns(
                request,
                admin,
                state=state,
                q=q,
                sort=normalized_sort,
                direction=normalized_dir,
            ),
            "rows": [
                _row(request, row, admin, auth.can_write(current_user), next_url)
                for row in rows
            ],
            "actions": [{"label": "Edit", "href_key": "edit_url"}],
            "description": DESCRIPTION,
            "list_url": str(request.url_for("[[ spec.app ]]_list")),
            "searchable": bool(_SEARCHABLE or (_ADMIN_SEARCHABLE if admin else ())),
            "q": q,
            "sort": normalized_sort,
            "dir": normalized_dir,
            "state": state,
[% if spec.workflow_field %]
            "empty": {
                "title": (
                    "Nothing needs a decision"
                    if state == ""
                    else "No [[ spec.title|lower ]] yet"
                ),
                "text": (
                    f"New {SINGULAR} will appear here when they arrive."
                    if state == ""
                    else DESCRIPTION or None
                ),
                "cta": {"label": "New [[ spec.singular_title ]]", "href": new_url}
                if new_url
                else None,
            },
[% else %]
            "empty": {
                "title": "No [[ spec.title|lower ]] yet",
                "text": DESCRIPTION or None,
                "cta": {"label": "New [[ spec.singular_title ]]", "href": new_url}
                if new_url
                else None,
            },
[% endif %]
            "new_url": new_url,
[% if spec.workflow_field %]
            "stats": [
                {"label": "Waiting", "value": open_count},
                {"label": "Decided today", "value": decided_today},
                {"label": "Total", "value": total},
            ],
            "tabs": tabs,
[% endif %]
        },
    )


@router.get("/new", name="[[ spec.app ]]_new")
def new_row(request: Request, session: DbSession, current_user: CurrentUser):
[% if spec.create_is_admin_only %]
    auth.require_admin(current_user)
[% else %]
    auth.require_write(current_user)
[% endif %]
    admin = auth.is_admin(current_user)
    return _form_page(
        request,
        session,
        {},
        {},
        admin,
        action=str(request.url_for("[[ spec.app ]]_create")),
        heading="New [[ spec.singular_title ]]",
    )


@router.post("", name="[[ spec.app ]]_create")
def create_row(
    request: Request,
    session: DbSession,
    current_user: CurrentUser,
[% for line in form_params %]
    [[ line ]]
[% endfor %]
):
[% if spec.create_is_admin_only %]
    auth.require_admin(current_user)
[% else %]
    auth.require_write(current_user)
[% endif %]
    admin = auth.is_admin(current_user)
    values, errors = _parse([[ submitted_dict ]], admin)
[% if reference_rows %]
    _check_references(session, values, errors)
[% endif %]
    if errors:
        return _form_page(
            request,
            session,
            values,
            errors,
            admin,
            action=str(request.url_for("[[ spec.app ]]_create")),
            heading="New [[ spec.singular_title ]]",
            status_code=400,
        )
    row = [[ spec.class_name ]](**values)
    audit.insert(session, row)
    return RedirectResponse(request.url_for("[[ spec.app ]]_detail", [[ spec.entity ]]_id=row.id), status_code=303)


@router.get("/{[[ spec.entity ]]_id}", name="[[ spec.app ]]_detail")
def detail_row(
    request: Request, session: DbSession, current_user: CurrentUser, [[ spec.entity ]]_id: int
):
    row = _get(session, [[ spec.entity ]]_id)
    admin = auth.is_admin(current_user)
[% if spec.workflow_field %]
    current_value = row.[[ spec.workflow_field.name ]]
    current = {
        "label": current_value,
        "tone": [[ spec.workflow_field.name|upper ]]_TONES.get(current_value, "neutral"),
    }
    decisions = [
        {"label": option.title(), "value": option, "tone": [[ spec.workflow_field.name|upper ]]_TONES.get(option, "neutral")}
        for option in [[ spec.workflow_field.name|upper ]]_OPTIONS
        if option in [[ spec.workflow_field.name|upper ]]_TRANSITIONS.get(
            current_value,
            tuple(option for option in [[ spec.workflow_field.name|upper ]]_OPTIONS if option != current_value),
        )
    ]
[% endif %]
    return templates.TemplateResponse(
        request,
        "[[ spec.app ]]/detail.html",
        {
            "title": "{} {}".format(SINGULAR, row.id),
            "row_id": row.id,
            "items": _items(row, admin),
            "list_url": str(request.url_for("[[ spec.app ]]_list")),
            "edit_url": (
                str(request.url_for("[[ spec.app ]]_edit", [[ spec.entity ]]_id=row.id))
                if auth.can_write(current_user)
                else None
            ),
            "delete_url": (
                str(request.url_for("[[ spec.app ]]_delete", [[ spec.entity ]]_id=row.id))
                if auth.can_write(current_user)
                else None
            ),
[% if spec.workflow_field %]
            "current": current,
            "decisions": decisions,
            "decision_url": str(request.url_for("[[ spec.app ]]_decide", [[ spec.entity ]]_id=row.id)),
            "can_decide": auth.can_write(current_user),
[% endif %]
        },
    )


[% if spec.workflow_field %]
@router.post("/{[[ spec.entity ]]_id}/status", name="[[ spec.app ]]_decide")
def decide_row(
    request: Request,
    session: DbSession,
    current_user: CurrentUser,
    [[ spec.entity ]]_id: int,
    [[ spec.workflow_field.name ]]: Annotated[str, Form()] = "",
    expected: Annotated[str, Form()] = "",
    next: Annotated[str, Form()] = "",
):
    auth.require_write(current_user)
    row = _get(session, [[ spec.entity ]]_id)
    if expected and expected != row.[[ spec.workflow_field.name ]]:
        raise HTTPException(
            status_code=409,
            detail=(
                f"this {SINGULAR} was already moved to {row.[[ spec.workflow_field.name ]]} "
                "by someone else; reload to see it"
            ),
        )
    if [[ spec.workflow_field.name ]] not in [[ spec.workflow_field.name|upper ]]_OPTIONS:
        raise HTTPException(status_code=400, detail="invalid status")
    if [[ spec.workflow_field.name ]] not in [[ spec.workflow_field.name|upper ]]_TRANSITIONS.get(
        row.[[ spec.workflow_field.name ]],
        tuple(
            option
            for option in [[ spec.workflow_field.name|upper ]]_OPTIONS
            if option != row.[[ spec.workflow_field.name ]]
        ),
    ):
        raise HTTPException(status_code=400, detail="transition not allowed")
    audit.update(session, row, {"[[ spec.workflow_field.name ]]": [[ spec.workflow_field.name ]]})
    return _redirect_next(request, next)


[% endif %]
@router.post("/{[[ spec.entity ]]_id}/toggle/{column}", name="[[ spec.app ]]_toggle")
def toggle_row(
    request: Request,
    session: DbSession,
    current_user: CurrentUser,
    [[ spec.entity ]]_id: int,
    column: str,
    value: Annotated[str | None, Form()] = None,
    expected: Annotated[str, Form()] = "",
    next: Annotated[str, Form()] = "",
):
    if column not in _TOGGLEABLE:
        raise HTTPException(status_code=404, detail="no such toggle")
    auth.require_write(current_user)
    if column in _SENSITIVE_TOGGLEABLE and not auth.is_admin(current_user):
        raise HTTPException(status_code=403, detail="admin access required")
    row = _get(session, [[ spec.entity ]]_id)
    current = bool(getattr(row, column))
    if expected and expected != ("1" if current else "0"):
        raise HTTPException(
            status_code=409,
            detail=f"this [[ spec.singular_title ]] was already changed by someone else; reload to see it",
        )
    new_value = value is not None
    if new_value != current:
        audit.update(session, row, {column: new_value})
    return _redirect_next(request, next)


@router.get("/{[[ spec.entity ]]_id}/edit", name="[[ spec.app ]]_edit")
def edit_row(
    request: Request, session: DbSession, current_user: CurrentUser, [[ spec.entity ]]_id: int
):
    admin = auth.is_admin(current_user)
    row = _get(session, [[ spec.entity ]]_id)
    values = {[% for field in spec.fields %]"[[ field.column_name ]]": row.[[ field.column_name ]], [% endfor %]}
    return _form_page(
        request,
        session,
        values,
        {},
        admin,
        action=str(request.url_for("[[ spec.app ]]_update", [[ spec.entity ]]_id=row.id)),
        heading="Edit [[ spec.singular_title ]] {}".format(row.id),
        writable=auth.can_write(current_user),
        delete_url=str(request.url_for("[[ spec.app ]]_delete", [[ spec.entity ]]_id=row.id)),
        detail_url=str(request.url_for("[[ spec.app ]]_detail", [[ spec.entity ]]_id=row.id)),
        row_id=row.id,
    )


@router.post("/{[[ spec.entity ]]_id}", name="[[ spec.app ]]_update")
def update_row(
    request: Request,
    session: DbSession,
    current_user: CurrentUser,
    [[ spec.entity ]]_id: int,
[% for line in form_params %]
    [[ line ]]
[% endfor %]
):
    auth.require_write(current_user)
    admin = auth.is_admin(current_user)
    row = _get(session, [[ spec.entity ]]_id)
    values, errors = _parse([[ submitted_dict ]], admin)
[% if reference_rows %]
    _check_references(session, values, errors)
[% endif %]
[% if spec.workflow_field %]
    if (
        WORKFLOW_FIELD in values
        and values[WORKFLOW_FIELD] != row.[[ spec.workflow_field.name ]]
        and values[WORKFLOW_FIELD]
        not in [[ spec.workflow_field.name|upper ]]_TRANSITIONS.get(
            row.[[ spec.workflow_field.name ]],
            tuple(
                option
                for option in [[ spec.workflow_field.name|upper ]]_OPTIONS
                if option != row.[[ spec.workflow_field.name ]]
            ),
        )
    ):
        errors[WORKFLOW_FIELD] = "transition not allowed"
[% endif %]
    if errors:
        return _form_page(
            request,
            session,
            values,
            errors,
            admin,
            action=str(request.url_for("[[ spec.app ]]_update", [[ spec.entity ]]_id=row.id)),
            heading="Edit [[ spec.singular_title ]] {}".format(row.id),
            delete_url=str(request.url_for("[[ spec.app ]]_delete", [[ spec.entity ]]_id=row.id)),
            detail_url=str(request.url_for("[[ spec.app ]]_detail", [[ spec.entity ]]_id=row.id)),
            row_id=row.id,
            status_code=400,
        )
    audit.update(session, row, values)
    return RedirectResponse(request.url_for("[[ spec.app ]]_detail", [[ spec.entity ]]_id=row.id), status_code=303)


@router.post("/{[[ spec.entity ]]_id}/delete", name="[[ spec.app ]]_delete")
def delete_row(
    request: Request, session: DbSession, current_user: CurrentUser, [[ spec.entity ]]_id: int
):
    auth.require_write(current_user)
    row = _get(session, [[ spec.entity ]]_id)
    audit.delete(session, row)
    return RedirectResponse(request.url_for("[[ spec.app ]]_list"), status_code=303)
